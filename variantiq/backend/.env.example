# VariantIQ Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Application
# =============================================================================
APP_NAME=VariantIQ
ENVIRONMENT=development  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# =============================================================================
# Security
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_minimum_32_characters_long

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql+asyncpg://variantiq:password@localhost:5432/variantiq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false  # Set to true to log SQL queries

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600  # 1 hour in seconds
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# External APIs
# =============================================================================

# NCBI E-utilities (ClinVar, PubMed)
# Get API key from: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com
NCBI_RATE_LIMIT=10  # requests per second (3 without API key, 10 with key)

# DrugBank (requires paid license)
# Get API key from: https://go.drugbank.com/
DRUGBANK_API_KEY=your_drugbank_api_key_here

# OpenAI (for NLP features)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude (for NLP features)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# =============================================================================
# Monitoring
# =============================================================================

# Sentry (error tracking)
# Get DSN from: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# =============================================================================
# Data Pipeline
# =============================================================================
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=data/models

# Cron schedule for automatic data updates (cron format)
DATA_UPDATE_CRON=0 2 * * *  # Daily at 2 AM

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_DRUGGABILITY_SCORING=true
ENABLE_MARKET_ANALYSIS=true
ENABLE_PATENT_SEARCH=false
ENABLE_REAL_TIME_TRIALS=false

# =============================================================================
# Performance
# =============================================================================
MAX_WORKERS=4
REQUEST_TIMEOUT=30
DB_QUERY_TIMEOUT=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Logging
# =============================================================================
LOG_FILE=logs/variantiq.log
LOG_ROTATION=100 MB
LOG_RETENTION=10 days
